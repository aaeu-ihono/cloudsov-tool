  title   = {Managers' segment disclosure choices under {IFRS} 8: {EU} evidence},
  journal = {Accounting Forum},
  volume  = {42},
  number  = {4},
  pages   = {293--308},
  year    = {2018},
  doi     = {10.1016/j.accfor.2018.09.004},
  note    = {Accessed September 2026. Studies segment disclosure by European

  title        = {{IFRS} 8 Operating Segments},
  howpublished = {International Financial Reporting Standard},
  year         = {2021},
  note         = {Accessed September 2026. Paragraph 5 defines an operating
                  segment as a component whose results are regularly reviewed by
                  the entity's chief operating decision maker. Paragraph 13 sets
                  the quantitative thresholds: a segment must be reported
                  separately if its revenue, its profit or loss, or its assets
                  reach 10 per cent of the combined figure for all operating
                  segments},
  url          = {https://www.ifrs.org/content/dam/ifrs/publications/pdf-standards/english/2021/issued/part-a/ifrs-8-operating-segments.pdf}
}

@article{AboudRoberts_2018,

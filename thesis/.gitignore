# LaTeX build artifacts — everything here is regenerated by latexmk.
# Kept folder-local so the rules travel with the thesis and cannot
# accidentally swallow logs or output from backend/ or frontend/.

# Core auxiliary
*.aux
*.log
*.out
*.toc
*.lof
*.lot

# Bibliography
*.bbl
*.blg
*.bcf
*.run.xml

# latexmk / build tracking
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv

# Index, glossaries, acronyms
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.idx
*.ilg
*.ind

# Editor / misc
*.bak
*.sav
*.tmp
*~

# Compiled output.
# Comment the next line out if you want to version the built PDF — handy for
# sending a supervisor a fixed snapshot, but it is an ~800 KB binary that
# changes on every compile and will grow the repository quickly.
main.pdf

# scratch comparison, delete when you've chosen
font-comparison.pdf
